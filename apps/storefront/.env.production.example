# ---------------------------------------------------------------------------
# Storefront — production environment (raks.pk)
#
# Copy these into the host's environment-variables UI (Hostinger hPanel →
# your Node.js app → Environment variables). Do NOT commit a real .env file;
# `.env` and `.env.local` are gitignored on purpose.
# ---------------------------------------------------------------------------

# Canonical production origin. Drives canonical tags, sitemap.xml, JSON-LD and
# og:image/twitter:image resolution. MUST be the real https origin, no trailing
# slash — getting this wrong ships localhost URLs to Google.
NEXT_PUBLIC_SITE_URL=https://raks.pk

# Serve the catalog from the committed JSON snapshot (src/content/catalog)
# instead of calling a Medusa backend. Keep "true" while the site runs without
# a backend: it is what allows the build to succeed on the host.
# Regenerate the snapshot locally with `npm run export:catalog`, then commit.
NEXT_PUBLIC_USE_CATALOG_SNAPSHOT=true

# Medusa backend URL. Unused while the snapshot serves the catalog AND orders
# are taken by email: the bag lives in the browser and checkout posts to
# /api/orders. Point it at a real backend once one exists, flip the snapshot
# flag above to "false", and the Medusa cart/checkout path takes over again.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.raks.pk

# Required by check-env-variables.js — the build fails without it. Any non-empty
# value works while the snapshot is serving the catalog.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me

# Single-region store (Pakistan).
NEXT_PUBLIC_DEFAULT_REGION=pk

# Do NOT set NODE_ENV here. `next build` and `next start` set it to "production"
# themselves. Setting it in the host's env makes `npm install` skip
# devDependencies — which this build needs (tailwindcss, postcss, autoprefixer,
# typescript) — and the build fails with MODULE_NOT_FOUND.

# Optional — only needed when Stripe checkout is switched on.
NEXT_PUBLIC_STRIPE_KEY=

# ---------------------------------------------------------------------------
# Order email (REQUIRED to take orders)
#
# With no Medusa backend, an order IS this email — there is no admin holding a
# copy. If these are unset the checkout returns an error to the customer rather
# than pretending the order went through, and the order is written to the
# server log as a fallback record.
#
# Hostinger mailbox settings: hPanel -> Emails -> your domain -> Configuration.
# Use port 465 (implicit TLS) or 587 (STARTTLS).
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=orders@raks.pk
SMTP_PASS=replace_with_mailbox_password

# Where new orders are delivered. Defaults to SMTP_USER when unset.
ORDER_EMAIL_TO=orders@raks.pk

# Envelope sender. Must be a mailbox the SMTP account is allowed to send as,
# or the provider will reject the message. Defaults to SMTP_USER.
ORDER_EMAIL_FROM=orders@raks.pk

# ---------------------------------------------------------------------------
# Delivery charge
#
# "Free delivery over Rs 3,000" is promised throughout the site copy. The fee
# BELOW that threshold was never written down anywhere, so 250 is an assumption
# — set the real figure here. Read by both the browser (cart/checkout quote)
# and the order endpoint (authoritative total), so they cannot disagree.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=3000
NEXT_PUBLIC_SHIPPING_FEE=250

# ---------------------------------------------------------------------------
# Meta (Facebook) Pixel
#
# Optional — the ID is also hardcoded as the default in src/lib/meta-pixel.ts,
# so ads tracking works even if this is never set on the host. Override it to
# point the storefront at a different pixel (e.g. a test dataset).
#
# Events sent: PageView, ViewContent (product), ViewCategory (listing, custom),
# AddToCart, ViewCart (custom), InitiateCheckout, Purchase.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FB_PIXEL_ID=1076085052474317

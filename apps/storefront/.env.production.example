# ---------------------------------------------------------------------------
# Storefront — production environment (raks.pk)
#
# Copy these into the host's environment-variables UI (Hostinger hPanel →
# your Node.js app → Environment variables). Do NOT commit a real .env file;
# `.env` and `.env.local` are gitignored on purpose.
# ---------------------------------------------------------------------------

# Canonical production origin. Drives canonical tags, sitemap.xml, JSON-LD and
# og:image/twitter:image resolution. MUST be the real https origin, no trailing
# slash — getting this wrong ships localhost URLs to Google.
NEXT_PUBLIC_SITE_URL=https://raks.pk

# Serve the catalog from the committed JSON snapshot (src/content/catalog)
# instead of calling a Medusa backend. Keep "true" while the site runs without
# a backend: it is what allows the build to succeed on the host.
# Regenerate the snapshot locally with `npm run export:catalog`, then commit.
NEXT_PUBLIC_USE_CATALOG_SNAPSHOT=true

# Medusa backend URL. Unused for catalog reads while the snapshot is enabled,
# but still used by cart/customer/checkout calls. Point it at the real backend
# once one exists, and flip the snapshot flag above to "false".
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.raks.pk

# Required by check-env-variables.js — the build fails without it. Any non-empty
# value works while the snapshot is serving the catalog.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me

# Single-region store (Pakistan).
NEXT_PUBLIC_DEFAULT_REGION=pk

NODE_ENV=production

# Optional — only needed when Stripe checkout is switched on.
NEXT_PUBLIC_STRIPE_KEY=

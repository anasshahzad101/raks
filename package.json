{
  "name": "raks",
  "private": false,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "npm --workspace @dtc/storefront run build",
    "start": "npm --workspace @dtc/storefront run start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:install": "npm install --prefix apps/backend",
    "backend:seed": "npm --prefix apps/backend run seed",
    "backend:dev": "npm --prefix apps/backend run dev",
    "storefront:dev": "turbo dev --filter=@dtc/storefront"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.16.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  },
  "workspaces": [
    "apps/storefront"
  ],
  "overrides": {
    "ajv": "^8.0.0"
  }
}